AnnotationAssertion(rdfs:comment obo:MGPO_0002033 "previous logical def: '

has part' some 
    (quality
     and ('has modifier' some abnormal)
     and ('inheres in' some glycan))")
AnnotationAssertion(rdfs:label obo:MGPO_0002033 "abnormal glycan phenotype"@en)
SubClassOf(obo:MGPO_0002033 obo:MGPO_0002028)

