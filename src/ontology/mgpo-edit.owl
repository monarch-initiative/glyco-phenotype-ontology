SubClassOf(obo:MGPO_0002039 obo:MGPO_0002028)

# Class: obo:MGPO_0002041 (abnormal glycan length)

AnnotationAssertion(obo:IAO_0000115 obo:MGPO_0002041 "A change in the strucutre of a glycan chain due to variations in the number of sugar residue constituents.")
AnnotationAssertion(obo:MGPO_0002032 obo:MGPO_0002041 "Relevant Classification Axes (in order shown for exemplar classes above):
1  attachment (conjugated vs free glycans)
1.1  aglycone class (e.g. glycoprotein-linked vs glycolipid-linked)
1.1.1  more specific aglycone class (e.g. N-glycan  vs O-glycan for proteins)")
AnnotationAssertion(obo:MGPO_0002037 obo:MGPO_0002041 "abnormal length of glycan species")
AnnotationAssertion(rdfs:label obo:MGPO_0002041 "abnormal glycan length"@en)
SubClassOf(obo:MGPO_0002041 obo:MGPO_0002009)

# Class: obo:MGPO_0002042 (abnormal glycan linkage)

AnnotationAssertion(obo:IAO_0000115 obo:MGPO_0002042 "A change in the strucutre of a glycan chain due to altered types of linkages between sugar residues. ")
AnnotationAssertion(obo:MGPO_0002032 obo:MGPO_0002042 "Relevant Classification Axes (in order shown for exemplar classes above):
1  attachment (conjugated vs free glycans)
1.1  aglycone class (e.g. glycoprotein-linked vs glycopeptide-linked)
1.1.1  more specific aglycone class (e.g. N-glycan  vs O-glycan for proteins)")
AnnotationAssertion(rdfs:label obo:MGPO_0002042 "abnormal glycan linkage"@en)
SubClassOf(obo:MGPO_0002042 obo:MGPO_0002028)

# Class: obo:MGPO_0002048 (abnormal sialyl content in serum N-glycans)

AnnotationAssertion(obo:IAO_0000115 obo:MGPO_0002048 "A change in the strucutre of a serum-localized N-glycan chain due to variations in number and/or location of sialyl residues - typically an increased or decreased abundance of sialyl residues, or the substitution of sialyl residues for another residue type.")
AnnotationAssertion(rdfs:label obo:MGPO_0002048 "abnormal sialyl content in serum N-glycans"@en)
